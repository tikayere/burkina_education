{
 "doctype": "Print Format",
 "name": "Recu de Paiement",
 "doc_type": "Payment Entry",
 "module": "Finance",
 "standard": "Yes",
 "custom_format": 1,
 "print_format_type": "Jinja",
 "disabled": 0,
 "docstatus": 0,
 "html": "<style>\n  .recu-be { font-family: \"Helvetica Neue\", Arial, sans-serif; font-size: 12px; color: #1a1a1a; max-width: 620px; margin: 0 auto; }\n  .recu-be .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 2px solid #1a1a1a; padding-bottom: 8px; margin-bottom: 10px; }\n  .recu-be .header h1 { font-size: 16px; margin: 0; }\n  .recu-be .header .meta { text-align: right; font-size: 11px; }\n  .recu-be h2.title { text-align: center; text-transform: uppercase; font-size: 15px; margin: 10px 0; letter-spacing: 1px; }\n  .recu-be table.info { width: 100%; margin-bottom: 10px; }\n  .recu-be table.info td { padding: 3px 4px; }\n  .recu-be table.amount { width: 100%; border-collapse: collapse; margin: 10px 0; }\n  .recu-be table.amount th, .recu-be table.amount td { border: 1px solid #999; padding: 5px 8px; font-size: 11px; }\n  .recu-be table.amount th { background: #f0f0f0; text-align: left; }\n  .recu-be table.amount td.num { text-align: right; }\n  .recu-be table.refs { width: 100%; border-collapse: collapse; margin-bottom: 10px; }\n  .recu-be table.refs th, .recu-be table.refs td { border: 1px solid #999; padding: 4px 6px; font-size: 11px; }\n  .recu-be table.refs th { background: #f0f0f0; text-align: left; }\n  .recu-be table.refs td.num { text-align: right; }\n  .recu-be .total-row { font-weight: bold; }\n  .recu-be .signatures { display: flex; justify-content: space-between; margin-top: 40px; }\n  .recu-be .signatures div { width: 45%; text-align: center; border-top: 1px solid #1a1a1a; padding-top: 4px; font-size: 11px; }\n  .recu-be .verification { margin-top: 20px; font-size: 9px; color: #666; text-align: center; }\n</style>\n\n{%- set company = frappe.db.get_value(\"Company\", doc.company, [\"company_name\", \"default_currency\"], as_dict=True) if doc.company else None -%}\n\n<div class=\"recu-be\">\n  <div class=\"header\">\n    <div>\n      <h1>{{ company.company_name if company else doc.company }}</h1>\n      <div style=\"font-size: 10px;\">{{ _(\"Reçu généré via Burkina Education ERP\") }}</div>\n    </div>\n    <div class=\"meta\">\n      <div><strong>{{ _(\"N° Reçu\") }}:</strong> {{ doc.name }}</div>\n      <div><strong>{{ _(\"Date\") }}:</strong> {{ frappe.utils.format_date(doc.posting_date) }}</div>\n    </div>\n  </div>\n\n  <h2 class=\"title\">{{ _(\"Reçu de Paiement\") }}</h2>\n\n  <table class=\"info\">\n    <tr>\n      <td><strong>{{ _(\"Reçu de\") }}:</strong> {{ doc.party_name or doc.party }}</td>\n      <td><strong>{{ _(\"Mode de paiement\") }}:</strong> {{ doc.mode_of_payment or \"-\" }}</td>\n    </tr>\n    <tr>\n      <td><strong>{{ _(\"Référence\") }}:</strong> {{ doc.reference_no or \"-\" }}\n        {%- if doc.reference_date %} ({{ frappe.utils.format_date(doc.reference_date) }}){%- endif -%}\n      </td>\n      <td><strong>{{ _(\"Devise\") }}:</strong> {{ doc.paid_from_account_currency or (company.default_currency if company else \"\") }}</td>\n    </tr>\n  </table>\n\n  <table class=\"refs\">\n    <thead>\n      <tr>\n        <th>{{ _(\"Document réglé\") }}</th>\n        <th class=\"num\">{{ _(\"Montant alloué\") }}</th>\n      </tr>\n    </thead>\n    <tbody>\n      {%- for row in doc.references -%}\n      <tr>\n        <td>{{ row.reference_doctype }} {{ row.reference_name }}</td>\n        <td class=\"num\">{{ \"%.2f\"|format(row.allocated_amount) }}</td>\n      </tr>\n      {%- endfor -%}\n    </tbody>\n  </table>\n\n  <table class=\"amount\">\n    <tr class=\"total-row\">\n      <th>{{ _(\"Montant reçu\") }}</th>\n      <td class=\"num\">{{ \"%.2f\"|format(doc.paid_amount) }}</td>\n    </tr>\n  </table>\n\n  {%- if doc.remarks %}\n  <div><strong>{{ _(\"Remarques\") }}:</strong> {{ doc.remarks }}</div>\n  {%- endif %}\n\n  <div class=\"signatures\">\n    <div>{{ _(\"Signature du payeur\") }}</div>\n    <div>{{ _(\"Signature - Comptabilité\") }}</div>\n  </div>\n\n  <div class=\"verification\">\n    {{ _(\"Ce reçu est généré et archivé électroniquement.\") }}\n    {{ _(\"Référence de vérification\") }}: {{ doc.name }}-{{ doc.modified }}\n  </div>\n</div>\n",
 "font": "Default",
 "margin_top": 10.0,
 "margin_bottom": 10.0,
 "margin_left": 10.0,
 "margin_right": 10.0,
